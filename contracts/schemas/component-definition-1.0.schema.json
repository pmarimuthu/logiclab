{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclab.example/schemas/component-definition-1.0.schema.json",
  "title": "LogicLab Component Definition 1.0",
  "description": "Registry-managed component definition. Revision 1.0-r2 (BRD v1.1, gap G-12): parameterSchema and visualMetadata are restricted to safe, declarative shapes. No SVG, HTML, script or free-form objects. Pin ID uniqueness, simulation model registration and version immutability are checked by the registry, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definitionId",
    "version",
    "name",
    "category",
    "pins",
    "simulationModelId",
    "simulationModelVersion"
  ],
  "properties": {
    "definitionId": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "category": {
      "enum": [
        "LOGIC_GATE",
        "INPUT",
        "OUTPUT",
        "CONSTANT",
        "ARITHMETIC",
        "COMBINATIONAL",
        "SEQUENTIAL",
        "MEMORY",
        "TIMING",
        "CUSTOM",
        "HIERARCHICAL"
      ]
    },
    "description": { "type": "string", "maxLength": 4000 },
    "pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pin" }
    },
    "simulationModelId": { "$ref": "#/$defs/id" },
    "simulationModelVersion": { "$ref": "#/$defs/version" },
    "parameterSchema": { "$ref": "#/$defs/parameterSchema" },
    "visualMetadata": { "$ref": "#/$defs/visualMetadata" },
    "status": { "enum": ["ACTIVE", "DEPRECATED"], "default": "ACTIVE" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "description": "MAJOR.MINOR or MAJOR.MINOR.PATCH. A behaviour change needs a new MAJOR or MINOR version.",
      "type": "string",
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}(\\.[0-9]{1,4})?$"
    },
    "scalar": { "type": ["string", "number", "boolean"] },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinId", "name", "direction", "width", "required"],
      "properties": {
        "pinId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "direction": { "enum": ["INPUT", "OUTPUT", "BIDIRECTIONAL"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "parameterSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "integer", "number", "boolean"] },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/scalar" }
        },
        "default": { "$ref": "#/$defs/scalar" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "parameterSchema": {
      "description": "Safe subset of JSON Schema describing instance parameters. Always a closed object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "additionalProperties": { "const": false },
        "required": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "properties": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/parameterSpec" }
        }
      }
    },
    "visualMetadata": {
      "description": "Refers to a built-in symbol by ID. Symbol artwork lives in the trusted application bundle, never in data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["symbolId"],
      "properties": {
        "symbolId": { "$ref": "#/$defs/id" },
        "width": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "pinLayout": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["side", "offset"],
            "properties": {
              "side": { "enum": ["LEFT", "RIGHT", "TOP", "BOTTOM"] },
              "offset": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
